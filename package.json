    "bun-types": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
