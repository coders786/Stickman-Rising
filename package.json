{
  "name": "stickman-rising",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:iso": "STICKMAN_DIST_DIR=.next-build next build",
    "build:preview": "STICKMAN_DIST_DIR=.next-preview next build && cp -R .next-preview/static .next-preview/standalone/.next-preview/ && cp -R public .next-preview/standalone/",
    "preview": "DATABASE_URL=\"${DATABASE_URL:-file:$PWD/db/custom.db}\" HOSTNAME=0.0.0.0 PORT=${PORT:-3000} node .next-preview/standalone/server.js",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:animations",
    "test:animations": "bun .qa/audit-player-anim.ts && bun .qa/continuity-check.ts",
    "art:player": "node --import tsx scripts/render-player-sheet.ts",
    "art:dash-motion": "node --import tsx scripts/render-dash-motion.ts",
    "bench": "node --import tsx scripts/bench-render.mjs",
    "lint:bounds": "node scripts/lint-boundaries.mjs",
    "gate": "tsc --noEmit && node scripts/lint-boundaries.mjs && npm run lint:webgl && node --import tsx --test tests/*.test.ts",
    "check:bridge": "npm run typecheck && npm run lint:bounds && npm run lint:webgl && node --import tsx --test tests/bridge-route.test.ts tests/bridge-combat.test.ts tests/render-scale.test.ts tests/hud-layout.test.ts tests/persistence.test.ts tests/graphics-tiers.test.ts tests/perf-core.test.ts tests/ledger-gen.test.ts tests/hit-resolution.test.ts tests/player-motor.test.ts tests/projectile-sweep.test.ts tests/wave-framing.test.ts tests/fx-pool.test.ts tests/shadows.test.ts tests/profile-consumption.test.ts tests/environment-fronts.test.ts tests/environment-paint.test.ts tests/bridge-look.test.ts tests/ronin-light.test.ts tests/sacr-packing.test.ts tests/sacr-math.test.ts tests/bridge-lighting.test.ts tests/bridge-v4.test.ts tests/bridge-metro.test.ts tests/bridge-handoff.test.ts tests/bridge-post.test.ts tests/bridge-shop.test.ts tests/engine-invariants.test.ts",
    "art:bridge-data": "node --import tsx scripts/bake-bridge-data.ts",
    "lint:webgl": "node --import tsx scripts/lint-webgl.ts",
    "check:webgl:offline": "node --import tsx scripts/lint-webgl.ts --compile",
    "art:bridge-lighting": "node --import tsx scripts/bake-bridge-lighting.ts",
    "art:bridge-packed": "node --import tsx scripts/bake-bridge-packed.ts",
    "art:bridge-ktx": "node --import tsx scripts/bake-bridge-ktx.ts",
    "art:bridge-glass": "node --import tsx scripts/bake-bridge-glass.ts",
    "art:bridge-webp": "node --import tsx scripts/bake-bridge-webp.ts",
    "check:sacr": "node --import tsx --test tests/sacr-packing.test.ts tests/sacr-math.test.ts tests/bridge-lighting.test.ts tests/bridge-v4.test.ts tests/bridge-metro.test.ts tests/bridge-handoff.test.ts tests/bridge-post.test.ts tests/bridge-shop.test.ts tests/engine-invariants.test.ts",
    "prebuild": "npm run lint:webgl",
    "prebuild:iso": "npm run lint:webgl",
    "prebuild:preview": "npm run lint:webgl"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.3",
    "@mdxeditor/editor": "^4.5.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reactuses/core": "^6.6.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.10.1",
    "geist": "^1.9.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.20.0",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.1"
  }
}
