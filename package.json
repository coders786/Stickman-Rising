{
  "name": "stickman-rising",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:push:local": "node scripts/prisma-push-local.mjs",
    "db:generate": "node scripts/prisma-generate-offline.mjs",
    "db:generate:online": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:animations",
    "test:animations": "bun .qa/audit-player-anim.ts && bun .qa/continuity-check.ts",
    "art:player": "node --import tsx scripts/render-player-sheet.ts",
    "art:dash-motion": "node --import tsx scripts/render-dash-motion.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
