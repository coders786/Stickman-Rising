    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
